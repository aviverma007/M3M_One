NODE_ENV=production
PORT=4000
API_PREFIX=/v1
PUBLIC_URL=http://your-server:4000
CORS_ORIGIN=http://your-server

# Long random string — e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=3

# SQL Server
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=M3M_One
DB_USER=m3m_app
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Where uploaded files are stored (file share or local folder)
UPLOAD_DIR=./uploads

# Used once by `npm run seed` to create the first super admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
